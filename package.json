    "gsap": "^3.12.7",
    "pixi.js": "^8.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  },
  "cordova": {
    "plugins": {
      "cordova-plugin-vibration": {},
      "cordova-plugin-statusbar": {}
    },
    "platforms": [
      "android"
    ]
  }
}
