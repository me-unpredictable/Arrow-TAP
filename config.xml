<?xml version='1.0' encoding='utf-8'?>
<widget id="com.unpredictable.arrowtap" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0" xmlns:android="http://schemas.android.com/apk/res/android">
    <name>Arrow Tap</name>
    <description>Arrow Tap: The Great Neon Arrow Untangle Puzzle Game</description>
    <author email="me__unpredictable@github.com" href="https://github.com/me-unpredictable">@me__unpredictable</author>
    <content src="index.html" />
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    
    <preference name="Orientation" value="portrait" />
    <preference name="Fullscreen" value="true" />
    <preference name="StatusBarOverlaysWebView" value="false" />
    <preference name="DisallowOverscroll" value="true" />
    
    <!-- Android Configuration targeting Android 15 (API 35) & backward compatible to API 24+ -->
    <platform name="android">
        <preference name="android-minSdkVersion" value="24" />
        <preference name="android-targetSdkVersion" value="35" />
        <preference name="android-compileSdkVersion" value="35" />
        <preference name="AndroidXEnabled" value="true" />
        <allow-intent href="market:*" />
    </platform>
</widget>
